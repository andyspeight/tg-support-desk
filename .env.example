# TG Support Desk — environment configuration
# All secrets live in Vercel env vars (server-side only). Nothing here ever
# reaches the browser. Copy to .env.local for local dev.

# ── Supabase (project: tg-support-desk / fpgfeqbxywwufagctzwj, eu-west-2) ────
SUPABASE_URL=https://fpgfeqbxywwufagctzwj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (resolution agent + utilities) ─────────────────────────────────
ANTHROPIC_API_KEY=
# Strongest available model for the resolution agent (brief §4);
# claude-opus-4-8 is the configured fallback if cost/latency demands it.
RESOLUTION_MODEL=claude-fable-5
UTILITY_MODEL=claude-haiku-4-5
AI_CONFIDENCE_THRESHOLD=0.55
AI_MAX_TURNS=8
# SAFETY-CRITICAL toggle. true (default): the AI drafts into an internal note for
# a human to review/send — it NEVER emails customers. Set to false ONLY when going
# fully live after the parallel run. Leave as true until then.
AI_SHADOW_MODE=true

# ── Voyage AI (KB embeddings for pgvector RAG) ───────────────────────────────
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
RERANK_MODEL=rerank-2.5

# ── Airtable Clients base (source of truth for client identity) ──────────────
# PAT must be scoped READ-ONLY to the Clients base.
AIRTABLE_PAT=
AIRTABLE_CLIENTS_BASE_ID=
AIRTABLE_CLIENTS_TABLE=Clients
# Comma-separated field names searched when matching a requester email.
AIRTABLE_CLIENT_EMAIL_FIELDS=Email
# Optional. A SEPARATE, write-scoped PAT (data.records:write on the Clients base
# only) used solely to create client companies from the desk's "Add a company"
# UI. Leave unset to keep that feature dark and the desk's Airtable access
# read-only. Do NOT reuse AIRTABLE_PAT — keep read and write least-privilege.
AIRTABLE_WRITE_PAT=

# ── Gmail (help@agendas.group mailbox on Google Workspace) ───────────────────
# OAuth client + refresh token with scopes: gmail.readonly, gmail.send.
# See docs/GMAIL-SETUP.md. The channel only activates when all four are set.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Address the desk sends replies from. help@agendas.group is the authenticated
# primary Workspace mailbox (passes SPF/DKIM/DMARC, delivers reliably). Switch to
# help@travelgenix.io only once that domain's DKIM + SPF are set up in Workspace,
# otherwise its DMARC policy bounces the mail.
SUPPORT_EMAIL=help@agendas.group
# Optional: other addresses that are also "us" for the inbound loop-guard — e.g.
# the help@travelgenix.io alias that routes into this same mailbox.
SUPPORT_EMAIL_ALIASES=help@travelgenix.io
SUPPORT_FROM_NAME=Travelgenix Support
GMAIL_POLL_BATCH=10

# ── Auth (Travelgenix SSO — tg_session cookie on .travelify.io) ──────────────
# Central session validator (Luna Chat pattern). Returns { ok, user:{email,name?} }.
# NB: only works when the desk is served on a *.travelify.io host (so the browser
# sends the .travelify.io cookie). A non-travelify.io domain needs the token bridge.
TG_AUTH_SESSION_URL=https://id.travelify.io/api/auth/me
# Cross-domain SSO bridge — required only to run the desk on a NON-travelify.io
# domain (e.g. help.travelgenix.io). Dormant unless AUTH_SESSION_SECRET +
# SSO_BRIDGE_URL are set.
#   AUTH_SESSION_SECRET : long random string; signs the handoff + desk-session tokens.
#   SSO_BRIDGE_URL      : a *.travelify.io host pointing at THIS app (so it receives
#                         the tg_session cookie), e.g. https://auth.travelify.io
#   SSO_LOGIN_URL       : id.travelify.io login page for users with no session yet.
#   (APP_BASE_URL below must be the desk's public URL, e.g. https://help.travelgenix.io)
AUTH_SESSION_SECRET=
SSO_BRIDGE_URL=
SSO_LOGIN_URL=
# Comma-separated agent seats (Phase 1 allowlist; names to follow from Andy).
AGENT_EMAILS=
# Local development only — ignored in production builds.
AUTH_DEV_BYPASS=false
# Preview-only SSO bypass: set true on a Vercel *Preview* deployment to click
# through the app before .travelify.io SSO exists. Hard-blocked on production
# (VERCEL_ENV). NEVER set this on the Production environment. Remove once SSO is live.
PREVIEW_NO_SSO=false

# ── Infrastructure ───────────────────────────────────────────────────────────
# Vercel sends this automatically as `Authorization: Bearer ...` on cron hits.
CRON_SECRET=
DEFAULT_TENANT_ID=travelgenix

# Public base URL of the deployed app (e.g. https://desk.travelify.io).
# Required for customer-facing links such as the CSAT survey; if unset, the
# AI simply omits the survey link from resolution emails.
APP_BASE_URL=
# Signing key for CSAT survey links; falls back to CRON_SECRET if unset.
CSAT_SECRET=

# ── KB ingestion: Travelgenix University (Duda blog) via Firecrawl ────────────
# Dormant until FIRECRAWL_API_KEY is set (the sync cron is a safe no-op before then).
FIRECRAWL_API_KEY=
UNIVERSITY_BASE_URL=https://university.travelgenix.io
# Optional path prefix to restrict ingest (e.g. /post). Empty = whole site.
UNIVERSITY_PATH_PREFIX=
UNIVERSITY_BATCH=10
# false (default): ingested articles land as 'review' for approval. true: auto-publish.
UNIVERSITY_AUTOPUBLISH=false

# ── Cron tuning (optional; sensible defaults baked in) ───────────────────────
# Self-improvement loop (mine-kb): KB candidates per run + look-back window.
KB_MINE_PER_RUN=5
KB_MINE_WINDOW_HOURS=48
# stale-tickets sweep: hours a ticket can await an agent reply before alerting.
STALE_TICKET_HOURS=24
