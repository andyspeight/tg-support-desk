# TG Support Desk — environment configuration
# All secrets live in Vercel env vars (server-side only). Nothing here ever
# reaches the browser. Copy to .env.local for local dev.

# ── Supabase (project: tg-support-desk / fpgfeqbxywwufagctzwj, eu-west-2) ────
SUPABASE_URL=https://fpgfeqbxywwufagctzwj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (resolution agent + utilities) ─────────────────────────────────
ANTHROPIC_API_KEY=
# Strongest available model for the resolution agent (brief §4);
# claude-opus-4-8 is the configured fallback if cost/latency demands it.
RESOLUTION_MODEL=claude-fable-5
UTILITY_MODEL=claude-haiku-4-5
AI_CONFIDENCE_THRESHOLD=0.55
AI_MAX_TURNS=8

# ── Voyage AI (KB embeddings for pgvector RAG) ───────────────────────────────
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5

# ── Airtable Clients base (source of truth for client identity) ──────────────
# PAT must be scoped READ-ONLY to the Clients base.
AIRTABLE_PAT=
AIRTABLE_CLIENTS_BASE_ID=
AIRTABLE_CLIENTS_TABLE=Clients
# Comma-separated field names searched when matching a requester email.
AIRTABLE_CLIENT_EMAIL_FIELDS=Email

# ── Gmail (support@ mailbox on Google Workspace) ─────────────────────────────
# OAuth client + refresh token with scopes: gmail.readonly, gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SUPPORT_EMAIL=
SUPPORT_FROM_NAME=Travelgenix Support
GMAIL_POLL_BATCH=10

# ── Auth (Travelgenix SSO — tg_session cookie on .travelify.io) ──────────────
# Endpoint that validates the tg_session cookie (Luna Chat /api/auth-session pattern).
TG_AUTH_SESSION_URL=
# Comma-separated agent seats (Phase 1 allowlist; names to follow from Andy).
AGENT_EMAILS=
# Local development only — ignored in production builds.
AUTH_DEV_BYPASS=false
# Preview-only SSO bypass: set true on a Vercel *Preview* deployment to click
# through the app before .travelify.io SSO exists. Hard-blocked on production
# (VERCEL_ENV). NEVER set this on the Production environment. Remove once SSO is live.
PREVIEW_NO_SSO=false

# ── Infrastructure ───────────────────────────────────────────────────────────
# Vercel sends this automatically as `Authorization: Bearer ...` on cron hits.
CRON_SECRET=
DEFAULT_TENANT_ID=travelgenix

# Public base URL of the deployed app (e.g. https://desk.travelify.io).
# Required for customer-facing links such as the CSAT survey; if unset, the
# AI simply omits the survey link from resolution emails.
APP_BASE_URL=
# Signing key for CSAT survey links; falls back to CRON_SECRET if unset.
CSAT_SECRET=
